# NEXPIRE — Environment Variables Template
# Copy to `.env` and fill in real values. NEVER commit the real `.env` file.

# ---------- Database ----------
DATABASE_URL=postgresql://nexpire:nexpire@db:5432/nexpire
POSTGRES_USER=nexpire
POSTGRES_PASSWORD=nexpire
POSTGRES_DB=nexpire

# ---------- Redis / Celery ----------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---------- Twilio (SMS + WhatsApp) ----------
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_SMS_FROM_NUMBER=+10000000000
TWILIO_WHATSAPP_FROM_NUMBER=whatsapp:+10000000000
TWILIO_INBOUND_WEBHOOK_SECRET=your_webhook_validation_secret_here

# ---------- Payments (choose one, or both for region-based routing) ----------
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ---------- Weather ----------
OPENWEATHER_API_KEY=your_openweather_key_here

# ---------- App ----------
APP_ENV=development
APP_SECRET_KEY=change_me_to_a_random_string
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ---------- ML ----------
ML_MODEL_PATH=/app/app/ml/artifacts/pricing_model.joblib
ML_USE_SYNTHETIC_DATA=true
